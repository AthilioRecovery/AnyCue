{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyCue",
  "version": "0.1.1",
  "identifier": "app.anycue.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "AnyCue",
      "width": 980,
      "height": 655,
      "minWidth": 700,
      "minHeight": 510,
      "center": true,
      "decorations": false,
      "resizable": true,
      "backgroundColor": "#252525"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
